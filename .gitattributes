# Normalise line endings so a Windows checkout still runs on Linux containers.
* text=auto eol=lf

# Windows-only helpers keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets must never be rewritten.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pt    binary
*.onnx  binary
*.engine binary
*.woff  binary
*.woff2 binary
